# Required in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# Database. SQLite by default; point at a persistent volume in production.
# Examples:
#   Local dev:       sqlite:///instance/booking.db   (default)
#   Fly.io volume:   sqlite:////data/booking.db
#   Railway volume:  sqlite:////data/booking.db
#   Postgres (opt):  postgresql://user:pass@host:5432/dbname
# DATABASE_URL=sqlite:////data/booking.db

# Set FLASK_ENV=production to enable production checks. Default is production.
FLASK_ENV=production

# Set FORCE_HTTPS=1 if the app is served over HTTPS (sets Secure cookie flag).
FORCE_HTTPS=1

# Trust X-Forwarded-* headers from the reverse proxy. Default 1.
TRUST_PROXY=1

# First-deploy admin bootstrap. If set and no admin user exists yet,
# the app creates one automatically on startup. Safe to leave set —
# it's a no-op once an admin already exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# ── Email notifications (optional) ──────────────────────────────────────────
# On every booking or cancellation, the app emails NOTIFY_ADMIN_EMAIL.
#
# ── Option A: Resend HTTP API (recommended on PaaS — Railway, Render, Fly.io) ──
# Direct SMTP (port 587/465) is often blocked by PaaS providers.
# Resend uses HTTPS (port 443) which is always allowed. Free tier: 3,000/month.
# 1. Sign up at resend.com and create an API key.
# 2. Set RESEND_API_KEY below.
# 3. Optionally set MAIL_SENDER to a verified sender address (needs domain in Resend).
#    Without it, emails come from onboarding@resend.dev (fine for testing).
#
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# MAIL_SENDER=Lab Booking <you@yourdomain.com>

# ── Option B: SMTP (only if port 587 is open on your host) ───────────────────
# Gmail requires an App Password (Google Account → Security → App passwords).
#
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USE_SSL=0
# MAIL_USERNAME=sender@gmail.com
# MAIL_PASSWORD=your-16-char-app-password
# MAIL_SENDER=Instrument Booking <sender@gmail.com>

# Who receives the notifications. Defaults to ADMIN_EMAIL if not set.
# NOTIFY_ADMIN_EMAIL=lab-admin@example.com

# Gunicorn tuning (optional)
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=60
# PORT=8000
